<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_phenom_resources_explorer" targetNamespace="http://qaflow/bpmn">
  <bpmn:process id="phenom_resources_explorer" name="Phenom Resources Explorer" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start_re1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_re1" name="Open Homepage">
      <bpmn:incoming>flow_start_re1</bpmn:incoming>
      <bpmn:outgoing>flow_re1_re2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_re2" name="Open Essential Reads">
      <bpmn:incoming>flow_re1_re2</bpmn:incoming>
      <bpmn:outgoing>flow_re2_re3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_re3" name="Access 2026 Benchmark Report">
      <bpmn:incoming>flow_re2_re3</bpmn:incoming>
      <bpmn:outgoing>flow_re3_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="End">
      <bpmn:incoming>flow_re3_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_re1" sourceRef="start" targetRef="Activity_re1" />
    <bpmn:sequenceFlow id="flow_re1_re2" sourceRef="Activity_re1" targetRef="Activity_re2" />
    <bpmn:sequenceFlow id="flow_re2_re3" sourceRef="Activity_re2" targetRef="Activity_re3" />
    <bpmn:sequenceFlow id="flow_re3_end" sourceRef="Activity_re3" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="phenom_resources_explorer">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="160" y="180" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_re1_di" bpmnElement="Activity_re1">
        <dc:Bounds x="260" y="158" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_re2_di" bpmnElement="Activity_re2">
        <dc:Bounds x="430" y="158" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_re3_di" bpmnElement="Activity_re3">
        <dc:Bounds x="600" y="158" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="770" y="180" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_re1_di" bpmnElement="flow_start_re1">
        <di:waypoint x="196" y="198" />
        <di:waypoint x="260" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_re1_re2_di" bpmnElement="flow_re1_re2">
        <di:waypoint x="380" y="198" />
        <di:waypoint x="430" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_re2_re3_di" bpmnElement="flow_re2_re3">
        <di:waypoint x="550" y="198" />
        <di:waypoint x="600" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_re3_end_di" bpmnElement="flow_re3_end">
        <di:waypoint x="720" y="198" />
        <di:waypoint x="770" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
