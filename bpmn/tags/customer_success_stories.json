{
  "processKey": "customer_success_stories",
  "elementTests": {
    "open_customers": {
      "name": "Open customers page",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "goto",
          "url": "https://www.phenom.com/customers"
        },
        {
          "action": "waitForTimeout",
          "timeoutMs": 1500
        },
        {
          "action": "assertContains",
          "text": "Customers",
          "ignoreCase": true,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "customers"
        }
      ]
    },
    "verify_proof": {
      "name": "Verify customer proof points",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "assertContains",
          "text": "Phenom",
          "ignoreCase": false,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "proof"
        }
      ]
    }
  }
}