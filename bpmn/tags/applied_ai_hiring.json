{
  "processKey": "applied_ai_hiring",
  "elementTests": {
    "open_ai": {
      "name": "Open Applied AI",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "goto",
          "url": "https://www.phenom.com/artificial-intelligence"
        },
        {
          "action": "waitForTimeout",
          "timeoutMs": 1500
        },
        {
          "action": "assertContains",
          "text": "Applied AI",
          "ignoreCase": false,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "applied-ai"
        }
      ]
    },
    "verify_automation": {
      "name": "Verify automation messaging",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "assertContains",
          "text": "Automate",
          "ignoreCase": true,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "automation"
        }
      ]
    },
    "verify_outcomes": {
      "name": "Verify ROI outcomes",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "assertContains",
          "text": "ROI",
          "ignoreCase": false,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "roi"
        }
      ]
    }
  }
}