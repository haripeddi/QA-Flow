<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_phenom_careers_faq_review" targetNamespace="http://qaflow/bpmn">
  <bpmn:process id="phenom_careers_faq_review" name="Phenom Careers FAQ Review" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start_fq01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_fq01" name="Open Careers Site">
      <bpmn:incoming>flow_start_fq01</bpmn:incoming>
      <bpmn:outgoing>flow_fq01_fq02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_fq02" name="Dismiss Overlays">
      <bpmn:incoming>flow_fq01_fq02</bpmn:incoming>
      <bpmn:outgoing>flow_fq02_fq03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_fq03" name="Scroll To FAQ Section">
      <bpmn:incoming>flow_fq02_fq03</bpmn:incoming>
      <bpmn:outgoing>flow_fq03_fq04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_fq04" name="Load FAQ Items">
      <bpmn:incoming>flow_fq03_fq04</bpmn:incoming>
      <bpmn:outgoing>flow_fq04_g1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_fq_g1" name="FAQs present?" default="flow_g1_fq05">
      <bpmn:incoming>flow_fq04_g1</bpmn:incoming>
      <bpmn:outgoing>flow_g1_fq05</bpmn:outgoing>
      <bpmn:outgoing>flow_g1_fq13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_fq05" name="Read FAQ Question">
      <bpmn:incoming>flow_g1_fq05</bpmn:incoming>
      <bpmn:incoming>flow_g3_fq05</bpmn:incoming>
      <bpmn:outgoing>flow_fq05_fq06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_fq06" name="Expand Answer">
      <bpmn:incoming>flow_fq05_fq06</bpmn:incoming>
      <bpmn:outgoing>flow_fq06_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_fq_g2" name="Answer present?" default="flow_g2_fq07">
      <bpmn:incoming>flow_fq06_g2</bpmn:incoming>
      <bpmn:outgoing>flow_g2_fq07</bpmn:outgoing>
      <bpmn:outgoing>flow_g2_fq08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_fq07" name="Record Answer">
      <bpmn:incoming>flow_g2_fq07</bpmn:incoming>
      <bpmn:outgoing>flow_fq07_fq09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_fq08" name="Flag Missing Answer">
      <bpmn:incoming>flow_g2_fq08</bpmn:incoming>
      <bpmn:outgoing>flow_fq08_fq09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_fq09" name="Advance To Next FAQ">
      <bpmn:incoming>flow_fq07_fq09</bpmn:incoming>
      <bpmn:incoming>flow_fq08_fq09</bpmn:incoming>
      <bpmn:outgoing>flow_fq09_g3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_fq_g3" name="More FAQs?" default="flow_g3_fq10">
      <bpmn:incoming>flow_fq09_g3</bpmn:incoming>
      <bpmn:outgoing>flow_g3_fq05</bpmn:outgoing>
      <bpmn:outgoing>flow_g3_fq10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_fq10" name="Compile FAQ Summary">
      <bpmn:incoming>flow_g3_fq10</bpmn:incoming>
      <bpmn:outgoing>flow_fq10_fq11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_fq11" name="Verify Key Questions Present">
      <bpmn:incoming>flow_fq10_fq11</bpmn:incoming>
      <bpmn:outgoing>flow_fq11_fq12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_fq12" name="Generate Review Report">
      <bpmn:incoming>flow_fq11_fq12</bpmn:incoming>
      <bpmn:outgoing>flow_fq12_endok</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_fq13" name="No FAQs Handler">
      <bpmn:incoming>flow_g1_fq13</bpmn:incoming>
      <bpmn:outgoing>flow_fq13_endempty</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_ok" name="End OK">
      <bpmn:incoming>flow_fq12_endok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_empty" name="End Empty">
      <bpmn:incoming>flow_fq13_endempty</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_fq01" sourceRef="start" targetRef="Activity_fq01" />
    <bpmn:sequenceFlow id="flow_fq01_fq02" sourceRef="Activity_fq01" targetRef="Activity_fq02" />
    <bpmn:sequenceFlow id="flow_fq02_fq03" sourceRef="Activity_fq02" targetRef="Activity_fq03" />
    <bpmn:sequenceFlow id="flow_fq03_fq04" sourceRef="Activity_fq03" targetRef="Activity_fq04" />
    <bpmn:sequenceFlow id="flow_fq04_g1" sourceRef="Activity_fq04" targetRef="Gateway_fq_g1" />
    <bpmn:sequenceFlow id="flow_g1_fq05" sourceRef="Gateway_fq_g1" targetRef="Activity_fq05" />
    <bpmn:sequenceFlow id="flow_g1_fq13" sourceRef="Gateway_fq_g1" targetRef="Activity_fq13">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.variables.no_faqs}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_fq05_fq06" sourceRef="Activity_fq05" targetRef="Activity_fq06" />
    <bpmn:sequenceFlow id="flow_fq06_g2" sourceRef="Activity_fq06" targetRef="Gateway_fq_g2" />
    <bpmn:sequenceFlow id="flow_g2_fq07" sourceRef="Gateway_fq_g2" targetRef="Activity_fq07" />
    <bpmn:sequenceFlow id="flow_g2_fq08" sourceRef="Gateway_fq_g2" targetRef="Activity_fq08">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.variables.answer_missing}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_fq07_fq09" sourceRef="Activity_fq07" targetRef="Activity_fq09" />
    <bpmn:sequenceFlow id="flow_fq08_fq09" sourceRef="Activity_fq08" targetRef="Activity_fq09" />
    <bpmn:sequenceFlow id="flow_fq09_g3" sourceRef="Activity_fq09" targetRef="Gateway_fq_g3" />
    <bpmn:sequenceFlow id="flow_g3_fq05" sourceRef="Gateway_fq_g3" targetRef="Activity_fq05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.variables.has_more_faqs}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_g3_fq10" sourceRef="Gateway_fq_g3" targetRef="Activity_fq10" />
    <bpmn:sequenceFlow id="flow_fq10_fq11" sourceRef="Activity_fq10" targetRef="Activity_fq11" />
    <bpmn:sequenceFlow id="flow_fq11_fq12" sourceRef="Activity_fq11" targetRef="Activity_fq12" />
    <bpmn:sequenceFlow id="flow_fq12_endok" sourceRef="Activity_fq12" targetRef="end_ok" />
    <bpmn:sequenceFlow id="flow_fq13_endempty" sourceRef="Activity_fq13" targetRef="end_empty" />
  </bpmn:process>
