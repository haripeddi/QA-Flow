<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_CareerSiteExperience" targetNamespace="http://qaflow/bpmn">
  <bpmn:process id="career_site_experience" name="Career Site Candidate Experience" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="open_home" name="Open Phenom home" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="open_career_site" name="Open Career Site product" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="verify_personalization" name="Verify talent community &amp; search" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>flow_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start" targetRef="open_home" />
    <bpmn:sequenceFlow id="flow_0" sourceRef="open_home" targetRef="open_career_site" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="open_career_site" targetRef="verify_personalization" />
    <bpmn:sequenceFlow id="flow_end" sourceRef="verify_personalization" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="career_site_experience">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="120" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="126" y="243" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="open_home_di" bpmnElement="open_home">
        <dc:Bounds x="220" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="open_career_site_di" bpmnElement="open_career_site">
        <dc:Bounds x="400" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verify_personalization_di" bpmnElement="verify_personalization">
        <dc:Bounds x="580" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="760" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="756" y="243" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_di" bpmnElement="flow_start">
        <di:waypoint x="156" y="218" />
        <di:waypoint x="220" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_0_di" bpmnElement="flow_0">
        <di:waypoint x="360" y="218" />
        <di:waypoint x="400" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="540" y="218" />
        <di:waypoint x="580" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_end_di" bpmnElement="flow_end">
        <di:waypoint x="720" y="218" />
        <di:waypoint x="760" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
