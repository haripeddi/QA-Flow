<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_phenom_jobs_pagination" targetNamespace="http://qaflow/bpmn">
  <bpmn:process id="phenom_jobs_pagination" name="Phenom Careers Job Search Pagination" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start_jp01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_jp01" name="Open Careers Site">
      <bpmn:incoming>flow_start_jp01</bpmn:incoming>
      <bpmn:outgoing>flow_jp01_jp02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_jp02" name="Dismiss Overlays">
      <bpmn:incoming>flow_jp01_jp02</bpmn:incoming>
      <bpmn:outgoing>flow_jp02_jp03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_jp03" name="Open Job Search">
      <bpmn:incoming>flow_jp02_jp03</bpmn:incoming>
      <bpmn:outgoing>flow_jp03_jp04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_jp04" name="Load Search Results">
      <bpmn:incoming>flow_jp03_jp04</bpmn:incoming>
      <bpmn:outgoing>flow_jp04_g1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_jp_g1" name="Results found?" default="flow_g1_jp05">
      <bpmn:incoming>flow_jp04_g1</bpmn:incoming>
      <bpmn:outgoing>flow_g1_jp05</bpmn:outgoing>
      <bpmn:outgoing>flow_g1_jp11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_jp05" name="Read Current Page Results">
      <bpmn:incoming>flow_g1_jp05</bpmn:incoming>
      <bpmn:incoming>flow_g2_jp05</bpmn:incoming>
      <bpmn:outgoing>flow_jp05_jp06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_jp06" name="Capture Job Card Titles">
      <bpmn:incoming>flow_jp05_jp06</bpmn:incoming>
      <bpmn:outgoing>flow_jp06_jp07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_jp07" name="Record Page Number">
      <bpmn:incoming>flow_jp06_jp07</bpmn:incoming>
      <bpmn:outgoing>flow_jp07_jp08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_jp08" name="Go To Next Page">
      <bpmn:incoming>flow_jp07_jp08</bpmn:incoming>
      <bpmn:outgoing>flow_jp08_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_jp_g2" name="More pages?" default="flow_g2_jp09">
      <bpmn:incoming>flow_jp08_g2</bpmn:incoming>
      <bpmn:outgoing>flow_g2_jp05</bpmn:outgoing>
      <bpmn:outgoing>flow_g2_jp09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_jp09" name="Compile Job List">
      <bpmn:incoming>flow_g2_jp09</bpmn:incoming>
      <bpmn:outgoing>flow_jp09_jp10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_jp10" name="Validate Job Count">
      <bpmn:incoming>flow_jp09_jp10</bpmn:incoming>
      <bpmn:outgoing>flow_jp10_endok</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_jp11" name="No Results Handler">
      <bpmn:incoming>flow_g1_jp11</bpmn:incoming>
      <bpmn:outgoing>flow_jp11_endempty</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_ok" name="End OK">
      <bpmn:incoming>flow_jp10_endok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_empty" name="End Empty">
      <bpmn:incoming>flow_jp11_endempty</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_jp01" sourceRef="start" targetRef="Activity_jp01" />
    <bpmn:sequenceFlow id="flow_jp01_jp02" sourceRef="Activity_jp01" targetRef="Activity_jp02" />
    <bpmn:sequenceFlow id="flow_jp02_jp03" sourceRef="Activity_jp02" targetRef="Activity_jp03" />
    <bpmn:sequenceFlow id="flow_jp03_jp04" sourceRef="Activity_jp03" targetRef="Activity_jp04" />
    <bpmn:sequenceFlow id="flow_jp04_g1" sourceRef="Activity_jp04" targetRef="Gateway_jp_g1" />
    <bpmn:sequenceFlow id="flow_g1_jp05" sourceRef="Gateway_jp_g1" targetRef="Activity_jp05" />
    <bpmn:sequenceFlow id="flow_g1_jp11" sourceRef="Gateway_jp_g1" targetRef="Activity_jp11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.variables.no_results}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_jp05_jp06" sourceRef="Activity_jp05" targetRef="Activity_jp06" />
    <bpmn:sequenceFlow id="flow_jp06_jp07" sourceRef="Activity_jp06" targetRef="Activity_jp07" />
    <bpmn:sequenceFlow id="flow_jp07_jp08" sourceRef="Activity_jp07" targetRef="Activity_jp08" />
    <bpmn:sequenceFlow id="flow_jp08_g2" sourceRef="Activity_jp08" targetRef="Gateway_jp_g2" />
    <bpmn:sequenceFlow id="flow_g2_jp05" sourceRef="Gateway_jp_g2" targetRef="Activity_jp05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.variables.has_more_pages}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_g2_jp09" sourceRef="Gateway_jp_g2" targetRef="Activity_jp09" />
    <bpmn:sequenceFlow id="flow_jp09_jp10" sourceRef="Activity_jp09" targetRef="Activity_jp10" />
    <bpmn:sequenceFlow id="flow_jp10_endok" sourceRef="Activity_jp10" targetRef="end_ok" />
    <bpmn:sequenceFlow id="flow_jp11_endempty" sourceRef="Activity_jp11" targetRef="end_empty" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="phenom_jobs_pagination">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="120" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_jp01_di" bpmnElement="Activity_jp01">
        <dc:Bounds x="200" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_jp02_di" bpmnElement="Activity_jp02">
        <dc:Bounds x="360" y="178" width="120" height="80" />
