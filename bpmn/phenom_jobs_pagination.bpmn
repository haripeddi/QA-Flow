      <bpmndi:BPMNShape id="Gateway_jp_g1_di" bpmnElement="Gateway_jp_g1" isMarkerVisible="true">
        <dc:Bounds x="845" y="193" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="835" y="163" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_jp05_di" bpmnElement="Activity_jp05">
        <dc:Bounds x="940" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_jp06_di" bpmnElement="Activity_jp06">
        <dc:Bounds x="1100" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_jp07_di" bpmnElement="Activity_jp07">
        <dc:Bounds x="1260" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_jp08_di" bpmnElement="Activity_jp08">
        <dc:Bounds x="1420" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_jp_g2_di" bpmnElement="Gateway_jp_g2" isMarkerVisible="true">
        <dc:Bounds x="1585" y="193" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1575" y="163" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_jp09_di" bpmnElement="Activity_jp09">
        <dc:Bounds x="1680" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_jp10_di" bpmnElement="Activity_jp10">
        <dc:Bounds x="1840" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_jp11_di" bpmnElement="Activity_jp11">
        <dc:Bounds x="940" y="320" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok">
        <dc:Bounds x="2000" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2006" y="243" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_empty_di" bpmnElement="end_empty">
        <dc:Bounds x="1100" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1095" y="385" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_jp01_di" bpmnElement="flow_start_jp01">
        <di:waypoint x="156" y="218" />
        <di:waypoint x="200" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_jp01_jp02_di" bpmnElement="flow_jp01_jp02">
        <di:waypoint x="320" y="218" />
