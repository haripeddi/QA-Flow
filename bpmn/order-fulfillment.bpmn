<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_OrderFulfillment"
                  targetNamespace="http://qaflow/bpmn">
  <bpmn:process id="order_fulfillment" name="Order Fulfillment" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start_to_create</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="create_order" name="Create Order"
                      camunda:type="external" camunda:topic="http.api">
      <bpmn:incoming>flow_start_to_create</bpmn:incoming>
      <bpmn:outgoing>flow_create_to_verify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="verify_order" name="Verify Order Exists"
                      camunda:type="external" camunda:topic="http.api">
      <bpmn:incoming>flow_create_to_verify</bpmn:incoming>
      <bpmn:outgoing>flow_verify_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="gateway_found" name="Order found?" default="flow_to_fail">
      <bpmn:incoming>flow_verify_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_to_confirm</bpmn:outgoing>
      <bpmn:outgoing>flow_to_fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="send_confirmation" name="Send Confirmation"
                      camunda:type="external" camunda:topic="http.api">
      <bpmn:incoming>flow_to_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_confirm_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="log_failure" name="Log Failure"
                      camunda:type="external" camunda:topic="http.api">
      <bpmn:incoming>flow_to_fail</bpmn:incoming>
      <bpmn:outgoing>flow_fail_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end_ok" name="End OK">
      <bpmn:incoming>flow_confirm_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="end_fail" name="End Failed">
      <bpmn:incoming>flow_fail_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_start_to_create" sourceRef="start" targetRef="create_order"/>
    <bpmn:sequenceFlow id="flow_create_to_verify" sourceRef="create_order" targetRef="verify_order"/>
    <bpmn:sequenceFlow id="flow_verify_to_gateway" sourceRef="verify_order" targetRef="gateway_found"/>
    <bpmn:sequenceFlow id="flow_to_confirm" sourceRef="gateway_found" targetRef="send_confirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${environment.variables.verify_order_passed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_to_fail" sourceRef="gateway_found" targetRef="log_failure"/>
    <bpmn:sequenceFlow id="flow_confirm_to_end" sourceRef="send_confirmation" targetRef="end_ok"/>
    <bpmn:sequenceFlow id="flow_fail_to_end" sourceRef="log_failure" targetRef="end_fail"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="order_fulfillment">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="160" y="180" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="166" y="223" width="24" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="create_order_di" bpmnElement="create_order">
        <dc:Bounds x="250" y="158" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verify_order_di" bpmnElement="verify_order">
        <dc:Bounds x="420" y="158" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_found_di" bpmnElement="gateway_found" isMarkerVisible="true">
        <dc:Bounds x="595" y="173" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="585" y="143" width="70" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send_confirmation_di" bpmnElement="send_confirmation">
        <dc:Bounds x="700" y="78" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="log_failure_di" bpmnElement="log_failure">
        <dc:Bounds x="700" y="258" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok">
        <dc:Bounds x="872" y="100" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="868" y="143" width="44" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_fail_di" bpmnElement="end_fail">
        <dc:Bounds x="872" y="280" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="861" y="323" width="58" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow_start_to_create_di" bpmnElement="flow_start_to_create">
        <di:waypoint x="196" y="198"/><di:waypoint x="250" y="198"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_create_to_verify_di" bpmnElement="flow_create_to_verify">
        <di:waypoint x="370" y="198"/><di:waypoint x="420" y="198"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_verify_to_gateway_di" bpmnElement="flow_verify_to_gateway">
        <di:waypoint x="540" y="198"/><di:waypoint x="595" y="198"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_confirm_di" bpmnElement="flow_to_confirm">
        <di:waypoint x="620" y="173"/><di:waypoint x="620" y="118"/><di:waypoint x="700" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_fail_di" bpmnElement="flow_to_fail">
        <di:waypoint x="620" y="223"/><di:waypoint x="620" y="298"/><di:waypoint x="700" y="298"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirm_to_end_di" bpmnElement="flow_confirm_to_end">
        <di:waypoint x="820" y="118"/><di:waypoint x="872" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fail_to_end_di" bpmnElement="flow_fail_to_end">
        <di:waypoint x="820" y="298"/><di:waypoint x="872" y="298"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
