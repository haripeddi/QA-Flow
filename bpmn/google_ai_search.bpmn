<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_GoogleAiSearch" targetNamespace="http://qaflow/bpmn">
  <bpmn:process id="google_ai_search" name="Google AI Mode Search" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start_to_open</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="open_google" name="Open google.com" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_start_to_open</bpmn:incoming>
      <bpmn:outgoing>flow_open_to_ai</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="enter_ai_mode" name="Enter AI Mode" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_open_to_ai</bpmn:incoming>
      <bpmn:outgoing>flow_ai_to_search</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="search_bpmn" name="Search &#39;what is BPMN&#39;" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_ai_to_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_to_assert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="assert_bpmn" name="Assert response contains &#39;BPMN&#39;" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_search_to_assert</bpmn:incoming>
      <bpmn:outgoing>flow_assert_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_found" name="BPMN mentioned?" default="flow_to_fail">
      <bpmn:incoming>flow_assert_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_to_ok</bpmn:outgoing>
      <bpmn:outgoing>flow_to_fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_ok" name="Search OK">
      <bpmn:incoming>flow_to_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_fail" name="Assertion failed">
      <bpmn:incoming>flow_to_fail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_to_open" sourceRef="start" targetRef="open_google" />
    <bpmn:sequenceFlow id="flow_open_to_ai" sourceRef="open_google" targetRef="enter_ai_mode" />
    <bpmn:sequenceFlow id="flow_ai_to_search" sourceRef="enter_ai_mode" targetRef="search_bpmn" />
    <bpmn:sequenceFlow id="flow_search_to_assert" sourceRef="search_bpmn" targetRef="assert_bpmn" />
    <bpmn:sequenceFlow id="flow_assert_to_gateway" sourceRef="assert_bpmn" targetRef="gateway_found" />
    <bpmn:sequenceFlow id="flow_to_ok" sourceRef="gateway_found" targetRef="end_ok">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${environment.variables.assert_bpmn_passed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_to_fail" sourceRef="gateway_found" targetRef="end_fail" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="google_ai_search">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="120" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="126" y="243" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="open_google_di" bpmnElement="open_google">
        <dc:Bounds x="200" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="enter_ai_mode_di" bpmnElement="enter_ai_mode">
        <dc:Bounds x="360" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="search_bpmn_di" bpmnElement="search_bpmn">
        <dc:Bounds x="520" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assert_bpmn_di" bpmnElement="assert_bpmn">
        <dc:Bounds x="680" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_found_di" bpmnElement="gateway_found" isMarkerVisible="true">
        <dc:Bounds x="865" y="193" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="850" y="163" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok">
        <dc:Bounds x="970" y="120" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="958" y="163" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_fail_di" bpmnElement="end_fail">
        <dc:Bounds x="970" y="280" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="950" y="323" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_open_di" bpmnElement="flow_start_to_open">
        <di:waypoint x="156" y="218" />
        <di:waypoint x="200" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_open_to_ai_di" bpmnElement="flow_open_to_ai">
        <di:waypoint x="320" y="218" />
        <di:waypoint x="360" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ai_to_search_di" bpmnElement="flow_ai_to_search">
        <di:waypoint x="480" y="218" />
        <di:waypoint x="520" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_to_assert_di" bpmnElement="flow_search_to_assert">
        <di:waypoint x="640" y="218" />
        <di:waypoint x="680" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_assert_to_gateway_di" bpmnElement="flow_assert_to_gateway">
        <di:waypoint x="820" y="218" />
        <di:waypoint x="865" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_ok_di" bpmnElement="flow_to_ok">
        <di:waypoint x="890" y="193" />
        <di:waypoint x="890" y="138" />
        <di:waypoint x="970" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_to_fail_di" bpmnElement="flow_to_fail">
        <di:waypoint x="890" y="243" />
        <di:waypoint x="890" y="298" />
        <di:waypoint x="970" y="298" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
