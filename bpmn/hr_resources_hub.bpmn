<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_HrResourcesHub" targetNamespace="http://qaflow/bpmn">
  <bpmn:process id="hr_resources_hub" name="HR Resources Hub" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="open_resources" name="Open resources library" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="verify_branding" name="Verify Phenom branding" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>flow_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start" targetRef="open_resources" />
    <bpmn:sequenceFlow id="flow_0" sourceRef="open_resources" targetRef="verify_branding" />
    <bpmn:sequenceFlow id="flow_end" sourceRef="verify_branding" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="hr_resources_hub">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="120" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="126" y="243" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="open_resources_di" bpmnElement="open_resources">
        <dc:Bounds x="220" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verify_branding_di" bpmnElement="verify_branding">
        <dc:Bounds x="400" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="580" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="576" y="243" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_di" bpmnElement="flow_start">
        <di:waypoint x="156" y="218" />
        <di:waypoint x="220" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_0_di" bpmnElement="flow_0">
        <di:waypoint x="360" y="218" />
        <di:waypoint x="400" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_end_di" bpmnElement="flow_end">
        <di:waypoint x="540" y="218" />
        <di:waypoint x="580" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
