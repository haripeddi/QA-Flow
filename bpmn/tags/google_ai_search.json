{
  "processKey": "google_ai_search",
  "elementTests": {
    "open_google": {
      "name": "Open google.com",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "goto",
          "url": ""
        }
      ]
    },
    "enter_ai_mode": {
      "name": "Enter AI Mode (best-effort)",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "tryClick",
          "selector": "a:has-text(\"AI Mode\"), button:has-text(\"AI Mode\"), [aria-label*=\"AI Mode\" i]",
          "optional": true,
          "name": "click-ai-mode"
        },
        {
          "action": "waitForTimeout",
          "timeoutMs": 1500
        },
        {
          "action": "screenshot",
          "name": "after-ai-mode-attempt"
        }
      ]
    },
    "search_bpmn": {
      "name": "Search 'what is BPMN'",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "fill",
          "selector": "textarea[name=\"q\"], input[name=\"q\"], textarea[aria-label*=\"Ask AI Mode\" i]",
          "value": "what is BPMN",
          "timeoutMs": 15000
        },
        {
          "action": "press",
          "selector": "textarea[name=\"q\"], input[name=\"q\"], textarea[aria-label*=\"Ask AI Mode\" i]",
          "value": "Enter"
        },
        {
          "action": "waitForLoadState",
          "state": "domcontentloaded",
          "timeoutMs": 20000
        },
        {
          "action": "waitForTimeout",
          "timeoutMs": 3500,
          "name": "let-results-settle"
        },
        {
          "action": "screenshot",
          "name": "search-results"
        }
      ]
    },
    "assert_bpmn": {
      "name": "Assert response contains 'BPMN'",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "assertContains",
          "text": "BPMN",
          "ignoreCase": false,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "assertion-evidence"
        }
      ],
      "setVariables": {
        "assert_bpmn_passed": "expect.passed"
      }
    }
  }
}