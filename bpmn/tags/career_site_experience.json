{
  "processKey": "career_site_experience",
  "elementTests": {
    "open_home": {
      "name": "Open Phenom home",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "goto",
          "url": "https://www.phenom.com/"
        },
        {
          "action": "waitForTimeout",
          "timeoutMs": 1500
        },
        {
          "action": "assertContains",
          "text": "Phenom",
          "ignoreCase": false,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "home"
        }
      ]
    },
    "open_career_site": {
      "name": "Open Career Site product",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "goto",
          "url": "https://www.phenom.com/career-site"
        },
        {
          "action": "waitForTimeout",
          "timeoutMs": 1500
        },
        {
          "action": "assertContains",
          "text": "Career Site",
          "ignoreCase": true,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "career-site"
        }
      ]
    },
    "verify_personalization": {
      "name": "Verify talent community & search",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "assertContains",
          "text": "Talent Community",
          "ignoreCase": false,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "personalization"
        }
      ]
    }
  }
}