{
  "processKey": "order_fulfillment",
  "elementTests": {
    "create_order": {
      "name": "Create order returns 200",
      "type": "http.api",
      "request": {
        "method": "POST",
        "url": "http://localhost:4000/mock/orders",
        "headers": { "Content-Type": "application/json" },
        "body": { "orderId": 42, "sku": "WIDGET-1", "qty": 1 }
      },
      "expect": {
        "status": 200,
        "jsonPath": { "$.orderId": 42, "$.status": "created" }
      },
      "setVariables": {
        "create_order_passed": "expect.passed"
      }
    },
    "verify_order": {
      "name": "Verify order exists",
      "type": "http.api",
      "request": {
        "method": "GET",
        "url": "http://localhost:4000/mock/orders/42"
      },
      "expect": {
        "status": 200,
        "jsonPath": { "$.orderId": 42, "$.status": "active" }
      },
      "setVariables": {
        "verify_order_passed": "expect.passed"
      }
    },
    "send_confirmation": {
      "name": "Send confirmation email",
      "type": "http.api",
      "request": {
        "method": "POST",
        "url": "http://localhost:4000/mock/confirmations",
        "body": { "orderId": 42 }
      },
      "expect": { "status": 200 }
    },
    "log_failure": {
      "name": "Log failure to ops channel",
      "type": "http.api",
      "request": {
        "method": "POST",
        "url": "http://localhost:4000/mock/failures",
        "body": { "orderId": 42, "reason": "verify_order failed" }
      },
      "expect": { "status": 200 }
    }
  }
}
