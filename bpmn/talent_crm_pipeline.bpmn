<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_TalentCrmPipeline" targetNamespace="http://qaflow/bpmn">
  <bpmn:process id="talent_crm_pipeline" name="Talent CRM Pipeline" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="open_crm" name="Open Talent CRM" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="verify_fit_scores" name="Verify Fit Scores" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="verify_pipeline" name="Verify talent pipeline" camunda:type="external" camunda:topic="browser.playwright">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>flow_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start" targetRef="open_crm" />
    <bpmn:sequenceFlow id="flow_0" sourceRef="open_crm" targetRef="verify_fit_scores" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="verify_fit_scores" targetRef="verify_pipeline" />
    <bpmn:sequenceFlow id="flow_end" sourceRef="verify_pipeline" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="talent_crm_pipeline">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="120" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="126" y="243" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="open_crm_di" bpmnElement="open_crm">
        <dc:Bounds x="220" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verify_fit_scores_di" bpmnElement="verify_fit_scores">
        <dc:Bounds x="400" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verify_pipeline_di" bpmnElement="verify_pipeline">
        <dc:Bounds x="580" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="760" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="756" y="243" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_di" bpmnElement="flow_start">
        <di:waypoint x="156" y="218" />
        <di:waypoint x="220" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_0_di" bpmnElement="flow_0">
        <di:waypoint x="360" y="218" />
        <di:waypoint x="400" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="540" y="218" />
        <di:waypoint x="580" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_end_di" bpmnElement="flow_end">
        <di:waypoint x="720" y="218" />
        <di:waypoint x="760" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
