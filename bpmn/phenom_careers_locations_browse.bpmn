<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_phenom_careers_locations_browse" targetNamespace="http://qaflow/bpmn">
  <bpmn:process id="phenom_careers_locations_browse" name="Phenom Careers Locations Browser" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_start_lb01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_lb01" name="Open Careers Site">
      <bpmn:incoming>flow_start_lb01</bpmn:incoming>
      <bpmn:outgoing>flow_lb01_lb02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_lb02" name="Dismiss Overlays">
      <bpmn:incoming>flow_lb01_lb02</bpmn:incoming>
      <bpmn:outgoing>flow_lb02_lb03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_lb03" name="Scroll To Locations Section">
      <bpmn:incoming>flow_lb02_lb03</bpmn:incoming>
      <bpmn:outgoing>flow_lb03_lb04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_lb04" name="Load Location Cards">
      <bpmn:incoming>flow_lb03_lb04</bpmn:incoming>
      <bpmn:outgoing>flow_lb04_g1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_lb_g1" name="Locations available?" default="flow_g1_lb05">
      <bpmn:incoming>flow_lb04_g1</bpmn:incoming>
      <bpmn:outgoing>flow_g1_lb05</bpmn:outgoing>
      <bpmn:outgoing>flow_g1_lb13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_lb05" name="Read Location Card">
      <bpmn:incoming>flow_g1_lb05</bpmn:incoming>
      <bpmn:incoming>flow_g3_lb05</bpmn:incoming>
      <bpmn:outgoing>flow_lb05_lb06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_lb06" name="Check Region">
      <bpmn:incoming>flow_lb05_lb06</bpmn:incoming>
      <bpmn:outgoing>flow_lb06_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_lb_g2" name="Is primary hub?" default="flow_g2_lb08">
      <bpmn:incoming>flow_lb06_g2</bpmn:incoming>
      <bpmn:outgoing>flow_g2_lb07</bpmn:outgoing>
      <bpmn:outgoing>flow_g2_lb08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_lb07" name="Capture HQ Details">
      <bpmn:incoming>flow_g2_lb07</bpmn:incoming>
      <bpmn:outgoing>flow_lb07_lb09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_lb08" name="Capture Satellite Office Details">
      <bpmn:incoming>flow_g2_lb08</bpmn:incoming>
      <bpmn:outgoing>flow_lb08_lb09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_lb09" name="Record Location">
      <bpmn:incoming>flow_lb07_lb09</bpmn:incoming>
      <bpmn:incoming>flow_lb08_lb09</bpmn:incoming>
      <bpmn:outgoing>flow_lb09_lb10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_lb10" name="Go To Next Location">
      <bpmn:incoming>flow_lb09_lb10</bpmn:incoming>
      <bpmn:outgoing>flow_lb10_g3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_lb_g3" name="More locations?" default="flow_g3_lb11">
      <bpmn:incoming>flow_lb10_g3</bpmn:incoming>
      <bpmn:outgoing>flow_g3_lb05</bpmn:outgoing>
      <bpmn:outgoing>flow_g3_lb11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_lb11" name="Compile Location List">
      <bpmn:incoming>flow_g3_lb11</bpmn:incoming>
      <bpmn:outgoing>flow_lb11_lb12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_lb12" name="Validate Location Count">
      <bpmn:incoming>flow_lb11_lb12</bpmn:incoming>
      <bpmn:outgoing>flow_lb12_endok</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_lb13" name="No Locations Handler">
      <bpmn:incoming>flow_g1_lb13</bpmn:incoming>
      <bpmn:outgoing>flow_lb13_endempty</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_ok" name="End OK">
      <bpmn:incoming>flow_lb12_endok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_empty" name="End Empty">
      <bpmn:incoming>flow_lb13_endempty</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_lb01" sourceRef="start" targetRef="Activity_lb01" />
    <bpmn:sequenceFlow id="flow_lb01_lb02" sourceRef="Activity_lb01" targetRef="Activity_lb02" />
    <bpmn:sequenceFlow id="flow_lb02_lb03" sourceRef="Activity_lb02" targetRef="Activity_lb03" />
    <bpmn:sequenceFlow id="flow_lb03_lb04" sourceRef="Activity_lb03" targetRef="Activity_lb04" />
    <bpmn:sequenceFlow id="flow_lb04_g1" sourceRef="Activity_lb04" targetRef="Gateway_lb_g1" />
    <bpmn:sequenceFlow id="flow_g1_lb05" sourceRef="Gateway_lb_g1" targetRef="Activity_lb05" />
    <bpmn:sequenceFlow id="flow_g1_lb13" sourceRef="Gateway_lb_g1" targetRef="Activity_lb13">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.variables.no_locations}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_lb05_lb06" sourceRef="Activity_lb05" targetRef="Activity_lb06" />
    <bpmn:sequenceFlow id="flow_lb06_g2" sourceRef="Activity_lb06" targetRef="Gateway_lb_g2" />
    <bpmn:sequenceFlow id="flow_g2_lb07" sourceRef="Gateway_lb_g2" targetRef="Activity_lb07">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.variables.is_primary_hub}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_g2_lb08" sourceRef="Gateway_lb_g2" targetRef="Activity_lb08" />
    <bpmn:sequenceFlow id="flow_lb07_lb09" sourceRef="Activity_lb07" targetRef="Activity_lb09" />
    <bpmn:sequenceFlow id="flow_lb08_lb09" sourceRef="Activity_lb08" targetRef="Activity_lb09" />
    <bpmn:sequenceFlow id="flow_lb09_lb10" sourceRef="Activity_lb09" targetRef="Activity_lb10" />
    <bpmn:sequenceFlow id="flow_lb10_g3" sourceRef="Activity_lb10" targetRef="Gateway_lb_g3" />
    <bpmn:sequenceFlow id="flow_g3_lb05" sourceRef="Gateway_lb_g3" targetRef="Activity_lb05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${environment.variables.has_more_locations}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_g3_lb11" sourceRef="Gateway_lb_g3" targetRef="Activity_lb11" />
    <bpmn:sequenceFlow id="flow_lb11_lb12" sourceRef="Activity_lb11" targetRef="Activity_lb12" />
    <bpmn:sequenceFlow id="flow_lb12_endok" sourceRef="Activity_lb12" targetRef="end_ok" />
    <bpmn:sequenceFlow id="flow_lb13_endempty" sourceRef="Activity_lb13" targetRef="end_empty" />
  </bpmn:process>
