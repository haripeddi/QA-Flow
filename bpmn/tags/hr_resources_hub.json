{
  "processKey": "hr_resources_hub",
  "elementTests": {
    "open_resources": {
      "name": "Open resources library",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "goto",
          "url": "https://www.phenom.com/resources"
        },
        {
          "action": "waitForTimeout",
          "timeoutMs": 1500
        },
        {
          "action": "assertContains",
          "text": "Resources",
          "ignoreCase": true,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "resources"
        }
      ]
    },
    "verify_branding": {
      "name": "Verify Phenom branding",
      "type": "browser.playwright",
      "steps": [
        {
          "action": "assertContains",
          "text": "Phenom",
          "ignoreCase": false,
          "timeoutMs": 15000
        },
        {
          "action": "screenshot",
          "name": "branding"
        }
      ]
    }
  }
}